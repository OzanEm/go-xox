# Copy to .env before running: `cp .env.example .env`
# .env is gitignored; this file is the documented template.

# Signing key for access tokens. There is no default — the server refuses to
# start without it. Generate a real one with: openssl rand -base64 32
JWT_SECRET=dev-secret-change-me-before-you-deploy-anything

# How long an issued token stays valid. Kept short because JWTs cannot be
# revoked before they expire.
JWT_TTL=30m

# How long a refresh token stays exchangeable at POST /refresh. Longer than
# JWT_TTL by design — unlike the JWT it is stored server-side and revocable.
# time.ParseDuration syntax: no "d" unit, so a day is 24h.
REFRESH_TOKEN_TTL=24h

# Postgres. These feed both the postgres container and the server's DATABASE_URL.
POSTGRES_USER=xox
POSTGRES_PASSWORD=xox
POSTGRES_DB=xox
POSTGRES_PORT=5432

# Host port the API is published on.
HTTP_PORT=8080
